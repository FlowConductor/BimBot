# Bu dosyayi ".env" olarak kopyalayip kendi degerlerinizi girin.
# .env dosyasi .gitignore icindedir, repo'ya commit edilmez.

# Cloudinary thumbnail ayarlari (bos birakilirsa ozel thumbnail atlanir)
CLOUDINARY_CLOUD_NAME=your-cloud-name
THUMBNAIL_BASE_IMAGE=your-base-image

# Binary yollari (sadece PATH'te bulunmuyorsa gerekli)
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# EDGE_TTS_PATH=C:\path\to\edge-tts.exe
